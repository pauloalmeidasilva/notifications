        "dev": "vite",
        "test": "vitest run",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@vitejs/plugin-legacy": "latest",
        "eslint": "latest",
        "vite": "latest",
        "vitest": "latest",
        "jsdom": "latest"
    }
}
